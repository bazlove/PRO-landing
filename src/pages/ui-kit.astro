      <footer class="ui-kit-footer"><div class="ui-kit-container"><strong>Verified Editorial UI · v0.2</strong><p>Living prototype. Fictional data only. Not linked from production navigation.</p><a href="#overview">К началу</a></div></footer>

      <div class="ui-kit-toast" role="status" aria-live="polite" aria-atomic="true" hidden data-ui-kit-toast>Добавлено в сравнение</div>
      <UiKitCompanyQuickView />

      <script is:inline>
        (() => {
          const root = document.querySelector("[data-ui-kit-root]");
          if (!(root instanceof HTMLElement)) return;
          const themeKey = "verified-editorial-ui-kit-theme";
          const themeButtons = Array.from(root.querySelectorAll("[data-ui-kit-theme]"));
          const media = window.matchMedia("(prefers-color-scheme: dark)");
          const applyTheme = (preference) => {
            root.dataset.themePreference = preference;
            root.dataset.theme = preference === "system" ? (media.matches ? "dark" : "light") : preference;
            themeButtons.forEach((button) => button.setAttribute("aria-pressed", String(button.getAttribute("data-ui-kit-theme") === preference)));
          };
          themeButtons.forEach((button) => button.addEventListener("click", () => {
            const preference = button.getAttribute("data-ui-kit-theme") || "system";
            try { localStorage.setItem(themeKey, preference); } catch {}
            applyTheme(preference);
          }));
          const onSystemChange = () => { if (root.dataset.themePreference === "system") applyTheme("system"); };
          media.addEventListener("change", onSystemChange);
          applyTheme(root.dataset.themePreference || "system");

          root.querySelectorAll(".ui-kit-select").forEach((wrapper) => {
            if (!(wrapper instanceof HTMLElement) || wrapper.dataset.enhanced === "true") return;
            const select = wrapper.querySelector("select");
            if (!(select instanceof HTMLSelectElement)) return;
            wrapper.dataset.enhanced = "true";
            const open = () => { if (!select.disabled) wrapper.dataset.state = "open"; };
            const close = () => { wrapper.dataset.state = "closed"; };
            select.addEventListener("pointerdown", open);
            select.addEventListener("keydown", (event) => {
              if (["Enter", " ", "ArrowDown", "ArrowUp"].includes(event.key)) open();
              if (event.key === "Escape") close();
            });
            select.addEventListener("change", close);
            select.addEventListener("blur", close);
          });

          const quickView = root.querySelector("[data-ui-kit-quick-view]");
          const panel = root.querySelector("[data-ui-kit-quick-view-panel]");
          const openers = Array.from(root.querySelectorAll("[data-ui-kit-quick-view-open]"));
          const closers = Array.from(root.querySelectorAll("[data-ui-kit-quick-view-close]"));
          let returnFocus = null;
          let activeCard = null;
          const backgroundRegions = Array.from(root.querySelectorAll(":scope > header, :scope > nav, :scope > main, :scope > footer"));
          const focusableSelector = 'a[href], button:not([disabled]), input:not([disabled]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])';
          const updateCardInteraction = (card) => {
            if (!(card instanceof HTMLElement)) return;
            card.dataset.interaction = card.classList.contains("is-quick-view-open") ? "quick-view-open" : card.classList.contains("is-compare-selected") ? "compare-selected" : card.classList.contains("is-favorite-selected") ? "favorite-selected" : "default";
          };
          const closeQuickView = () => {
            if (!(quickView instanceof HTMLElement) || quickView.hidden) return;
            quickView.classList.remove("is-open");
            window.setTimeout(() => { quickView.hidden = true; }, window.matchMedia("(prefers-reduced-motion: reduce)").matches ? 0 : 240);
            document.body.classList.remove("ui-kit-dialog-open");
            backgroundRegions.forEach((region) => { if (region instanceof HTMLElement) region.inert = false; });
            if (activeCard instanceof HTMLElement) { activeCard.classList.remove("is-quick-view-open"); updateCardInteraction(activeCard); }
            if (returnFocus instanceof HTMLElement) returnFocus.focus();
            activeCard = null;
          };
          const openQuickView = (trigger) => {
            if (!(quickView instanceof HTMLElement) || !(panel instanceof HTMLElement)) return;
            returnFocus = trigger;
            activeCard = trigger.closest("[data-ui-kit-company-card]");
            if (activeCard instanceof HTMLElement) { activeCard.classList.add("is-quick-view-open"); updateCardInteraction(activeCard); }
            const setText = (selector, value) => { const node = quickView.querySelector(selector); if (node && value) node.textContent = value; };
            setText("[data-ui-kit-qv-title]", trigger.dataset.companyName);
            setText("[data-ui-kit-qv-meta]", trigger.dataset.companyMeta);
            setText("[data-ui-kit-qv-logo]", trigger.dataset.companyInitials);
            setText("[data-ui-kit-qv-hiring]", trigger.dataset.companyHiring);
            setText("[data-ui-kit-qv-hiring-detail]", trigger.dataset.companyHiring);
            setText("[data-ui-kit-qv-format]", trigger.dataset.companyFormat);
            setText("[data-ui-kit-qv-format-detail]", trigger.dataset.companyFormat);
            setText("[data-ui-kit-qv-rating]", trigger.dataset.companyRating && trigger.dataset.companyRatingNote ? `${trigger.dataset.companyRating} · ${trigger.dataset.companyRatingNote}` : "—");
            setText("[data-ui-kit-qv-rating-score]", trigger.dataset.companyRating);
            setText("[data-ui-kit-qv-rating-note]", trigger.dataset.companyRatingNote);
            setText("[data-ui-kit-qv-freshness]", trigger.dataset.companyFreshness);
            quickView.hidden = false;
            document.body.classList.add("ui-kit-dialog-open");
            backgroundRegions.forEach((region) => { if (region instanceof HTMLElement) region.inert = true; });
            requestAnimationFrame(() => { quickView.classList.add("is-open"); const closeButton = quickView.querySelector(".ui-kit-quick-view__header [data-ui-kit-quick-view-close]"); if (closeButton instanceof HTMLElement) closeButton.focus(); else panel.focus(); });
          };
          openers.forEach((opener) => opener.addEventListener("click", () => openQuickView(opener)));
          closers.forEach((closer) => closer.addEventListener("click", closeQuickView));
          document.addEventListener("keydown", (event) => {
            if (!(quickView instanceof HTMLElement) || quickView.hidden) return;
            if (event.key === "Escape") { event.preventDefault(); closeQuickView(); return; }
            if (event.key !== "Tab" || !(panel instanceof HTMLElement)) return;
            const focusable = Array.from(panel.querySelectorAll(focusableSelector)).filter((node) => node instanceof HTMLElement && !node.hidden);
            const first = focusable[0]; const last = focusable[focusable.length - 1];
            if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last?.focus(); }
            else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first?.focus(); }
          });

          root.querySelectorAll("[data-ui-kit-favorite]").forEach((button) => button.addEventListener("click", () => {
            if (!(button instanceof HTMLButtonElement)) return;
            const pressed = button.getAttribute("aria-pressed") !== "true";
            button.setAttribute("aria-pressed", String(pressed));
            button.classList.toggle("is-pressed", pressed);
            button.title = pressed ? "Удалить из избранного" : "Добавить в избранное";
            const card = button.closest("[data-ui-kit-company-card]");
            if (card instanceof HTMLElement) { card.classList.toggle("is-favorite-selected", pressed); updateCardInteraction(card); }
          }));

          root.querySelectorAll("[data-ui-kit-compare]").forEach((button) => button.addEventListener("click", () => {
            if (!(button instanceof HTMLButtonElement)) return;
            const pressed = button.getAttribute("aria-pressed") !== "true";
            button.setAttribute("aria-pressed", String(pressed));
            button.classList.toggle("is-active", pressed);
            if (!button.classList.contains("ui-kit-icon-button")) button.textContent = pressed ? "В сравнении" : (button.closest("[data-ui-kit-quick-view]") ? "Добавить в сравнение" : "Сравнить");
            const card = button.closest("[data-ui-kit-company-card], [data-ui-kit-compare-demo]") || activeCard;
            if (card instanceof HTMLElement) {
              card.classList.toggle("is-compare-selected", pressed);
              const cardButton = card.querySelector("[data-ui-kit-compare]");
              if (cardButton instanceof HTMLButtonElement && cardButton !== button) { cardButton.setAttribute("aria-pressed", String(pressed)); cardButton.classList.toggle("is-active", pressed); cardButton.textContent = pressed ? "В сравнении" : "Сравнить"; }
              updateCardInteraction(card);
            }
          }));

          const toast = root.querySelector("[data-ui-kit-toast]");
          let toastTimer;
          root.querySelector("[data-ui-kit-toast-trigger]")?.addEventListener("click", () => {
            if (!(toast instanceof HTMLElement)) return;
            window.clearTimeout(toastTimer); toast.hidden = false; toast.classList.add("is-visible");
            toastTimer = window.setTimeout(() => { toast.classList.remove("is-visible"); toast.hidden = true; }, 2600);
          });

          const fadeDemo = root.querySelector("[data-ui-kit-fade-demo]");
          root.querySelector("[data-ui-kit-fade-replay]")?.addEventListener("click", () => {
            if (!(fadeDemo instanceof HTMLElement)) return;
            fadeDemo.classList.remove("is-replaying"); void fadeDemo.offsetWidth; fadeDemo.classList.add("is-replaying");
          });
        })();
      </script>
    </div>
  </body>
