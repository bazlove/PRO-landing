---
import UiKitSection from "../components/ui-kit/UiKitSection.astro";
import UiKitSwatch from "../components/ui-kit/UiKitSwatch.astro";
import UiKitTrustState from "../components/ui-kit/UiKitTrustState.astro";
import UiKitCompanyCard from "../components/ui-kit/UiKitCompanyCard.astro";
import UiKitCompanyQuickView from "../components/ui-kit/UiKitCompanyQuickView.astro";
import UiKitCompanyPagePreview from "../components/ui-kit/UiKitCompanyPagePreview.astro";
import UiKitSemanticLabel from "../components/ui-kit/UiKitSemanticLabel.astro";
import { semanticLabels } from "../lib/ui-kit/semanticLabels";
import "../styles/ui-kit/tokens.css";
import "../styles/ui-kit/ui-kit.css";

const uiKitMeta = {
  version: "0.3",
  date: "03.08.2026",
} as const;

const paletteGroups = [
  {
    name: "Нейтральные",
    swatches: [
      ["neutral.0", "#FFFFFF", "Белая поверхность"], ["neutral.25", "#FCFCFA", "Фон страницы"],
      ["neutral.50", "#F7F7F3", "Вторичный фон"], ["neutral.100", "#EFEFEA", "Недоступная поверхность"],
      ["neutral.200", "#DEDED7", "Граница"], ["neutral.300", "#C6C6BE", "Усиленная граница"],
      ["neutral.500", "#7A7D82", "Приглушённый текст"], ["neutral.700", "#3B414A", "Вспомогательный текст"],
      ["neutral.900", "#121A26", "Основной текст"], ["neutral.950", "#0B111B", "Самая тёмная поверхность"],
    ],
  },
  { name: "Индиго", swatches: [["indigo.50", "#F1F3FF", "Мягкий брендовый фон"], ["indigo.100", "#E3E7FF", "Мягкое выбранное состояние"], ["indigo.200", "#C7CFFF", "Брендовая граница"], ["indigo.400", "#7484F4", "Акцент"], ["indigo.500", "#596BE5", "Яркий брендовый цвет"], ["indigo.600", "#4254CC", "Основное действие"], ["indigo.700", "#3443A8", "Основное наведение"], ["indigo.800", "#293683", "Основное нажатие"], ["indigo.900", "#202A64", "Глубокий брендовый цвет"]] },
  { name: "Коралловые", swatches: [["coral.50", "#FFF4F0", "Мягкий фирменный фон"], ["coral.100", "#FFE5DC", "Фирменная граница"], ["coral.300", "#FFAB91", "Светлый фирменный цвет"], ["coral.500", "#F56F4F", "Фирменный акцент"], ["coral.600", "#DA5638", "Усиленный фирменный цвет"], ["coral.700", "#B8432B", "Данные компании"]] },
  { name: "Мятные / проверено", swatches: [["mint.50", "#EFFAF4", "Фон проверки"], ["mint.100", "#D8F2E4", "Граница проверки"], ["mint.500", "#2F9B65", "Свежие данные"], ["mint.700", "#1E7048", "Текст проверки"]] },
  { name: "Янтарные / предупреждение", swatches: [["amber.50", "#FFF8E8", "Фон предупреждения"], ["amber.100", "#FDECC4", "Граница предупреждения"], ["amber.500", "#C88519", "Значок предупреждения"], ["amber.700", "#8B5B0E", "Текст предупреждения"]] },
  { name: "Красные / критическое", swatches: [["red.50", "#FFF1F1", "Критический фон"], ["red.100", "#FFDADA", "Критическая граница"], ["red.500", "#D94B4B", "Критический значок"], ["red.700", "#A52E2E", "Критический текст"]] },
  { name: "Фиолетовые / расширенный доступ", swatches: [["violet.50", "#F7F2FF", "Фон расширенного доступа"], ["violet.100", "#EBDDFF", "Граница расширенного доступа"], ["violet.500", "#8358D9", "Акцент расширенного доступа"], ["violet.700", "#5E38A5", "Текст расширенного доступа"]] },
] as const;

const sections = [
  { id: "overview", label: "Обзор" }, { id: "foundations", label: "Основы" }, { id: "colors", label: "Цвета" },
  { id: "typography", label: "Типографика" }, { id: "spacing-grid", label: "Отступы и сетка" }, { id: "shape", label: "Радиусы и уровни" },
  { id: "buttons", label: "Кнопки" }, { id: "forms", label: "Элементы форм" }, { id: "chips", label: "Чипы, теги и бейджи" },
  { id: "trust", label: "Доверие и источники" }, { id: "feedback", label: "Состояния" }, { id: "company-card", label: "Карточка компании" },
  { id: "quick-view", label: "Краткий профиль" }, { id: "company-page", label: "Страница компании" }, { id: "responsive", label: "Адаптивность" },
  { id: "motion", label: "Политика анимации" }, { id: "accessibility", label: "Доступность" },
] as const;

const spacing = [["space.1", 4], ["space.2", 8], ["space.3", 12], ["space.4", 16], ["space.5", 20], ["space.6", 24], ["space.8", 32], ["space.10", 40], ["space.12", 48], ["space.16", 64], ["space.20", 80], ["space.24", 96]] as const;
const semanticFamilyLabels = { chip: "чип", tag: "тег", badge: "бейдж" } as const;
const semanticVariantLabels: Record<string, string> = {
  default: "по умолчанию",
  neutral: "нейтральный",
  verified: "проверенный",
  conflict: "конфликт",
  "employer-claim": "данные компании",
  "external-source": "внешний источник",
  premium: "расширенный доступ",
  beta: "бета",
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Verified UI Kit — дизайн-система</title>
    <meta name="description" content="Изолированная живая документация дизайн-системы Verified UI Kit." />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body class="ui-kit-page">
    <a class="ui-kit-skip-link" href="#ui-kit-main">Перейти к содержанию</a>
    <div class="ui-kit-app" data-ui-kit-root data-theme="light">
      <script is:inline>
        (() => {
          const root = document.currentScript?.parentElement;
          if (!(root instanceof HTMLElement)) return;
          const key = "verified-editorial-ui-kit-theme";
          const media = window.matchMedia("(prefers-color-scheme: dark)");
          let preference = "system";
          try { preference = localStorage.getItem(key) || "system"; } catch {}
          root.dataset.themePreference = preference;
          root.dataset.theme = preference === "system" ? (media.matches ? "dark" : "light") : preference;
        })();
      </script>

      <header class="ui-kit-header">
        <div class="ui-kit-container ui-kit-header__inner">
          <a class="ui-kit-brand" href="#overview" aria-label="Verified UI Kit, начало страницы">
            <span aria-hidden="true">VU</span><strong>Verified UI Kit</strong>
          </a>
          <div class="ui-kit-theme-switcher" role="group" aria-label="Тема UI Kit">
            <button type="button" data-ui-kit-theme="light" aria-pressed="false">Светлая</button>
            <button type="button" data-ui-kit-theme="dark" aria-pressed="false">Тёмная</button>
            <button type="button" data-ui-kit-theme="system" aria-pressed="false">Системная</button>
          </div>
        </div>
      </header>

      <nav class="ui-kit-local-nav" aria-label="Навигация по разделам" data-ui-kit-section-nav>
        <div class="ui-kit-container ui-kit-local-nav__track ui-kit-scroll-x">
          {sections.map(({ id, label }, index) => <a href={`#${id}`} data-ui-kit-section-link data-section-index={index}><span class="ui-kit-local-nav__marker" aria-hidden="true"></span><span class="ui-kit-local-nav__number">{String(index).padStart(2, "0")}</span><span>{label}</span></a>)}
        </div>
      </nav>

      <main id="ui-kit-main" class="ui-kit-main">
        <section id="overview" class="ui-kit-hero" aria-labelledby="ui-kit-title">
          <div class="ui-kit-container ui-kit-hero__layout">
            <div>
              <p class="ui-kit-eyebrow">Дизайн-система · Документация для команды</p>
              <h1 id="ui-kit-title">Verified<br />UI Kit</h1>
              <p class="ui-kit-hero__lead">Интерфейс, ориентированный на данные, с редакционной подачей и прозрачным слоем доверия для осознанного выбора работодателя.</p>
              <div class="ui-kit-hero__principles"><span>Факты прежде оформления</span><span>Видимое доверие</span><span>Постепенное раскрытие</span><span>Устойчивость к реальным данным</span></div>
            </div>
            <aside class="ui-kit-hero__status">
              <span class="ui-kit-badge ui-kit-badge--beta">Прототип</span>
              <strong>Рабочая документация</strong>
              <p>Непроизводственные компоненты. Все компании, метрики и источники на странице вымышлены.</p>
              <dl><div><dt>Версия</dt><dd>{uiKitMeta.version}</dd></div><div><dt>Дата</dt><dd>{uiKitMeta.date}</dd></div><div><dt>Темы</dt><dd>Светлая / Тёмная / Системная</dd></div></dl>
            </aside>
          </div>
        </section>

        <div class="ui-kit-container ui-kit-document-layout">
          <div class="ui-kit-content">
          <UiKitSection id="foundations" eyebrow="01 · Основы" title="Семантика прежде значений" description="Компоненты обращаются к назначению токена, а не к конкретному оттенку. Тема меняет соответствие, но не контракт.">
            <div class="ui-kit-token-flow" aria-label="Уровни дизайн-токенов"><div><span>Базовый</span><code>indigo.600</code></div><b aria-hidden="true">→</b><div><span>Семантический</span><code>color.brand.primary</code></div><b aria-hidden="true">→</b><div><span>Компонентный</span><code>button.primary.bg</code></div></div>
            <div class="ui-kit-surface-demo">
              <div class="ui-kit-surface-demo__page"><span>Страница</span><div class="ui-kit-surface-demo__primary"><span>Основная поверхность</span><div class="ui-kit-surface-demo__elevated">Приподнятая поверхность</div></div></div>
              <div class="ui-kit-text-roles"><p class="is-primary">Основной текст — ключевой факт</p><p class="is-secondary">Вторичный текст — пояснение</p><p class="is-muted">Приглушённый текст — служебная метаинформация</p><p class="is-inverse">Инверсный текст — контрастная поверхность</p></div>
            </div>
            <div class="ui-kit-semantic-roles"><span class="is-brand">Бренд</span><span class="is-signature">Фирменный акцент</span><span class="is-verified">Проверено</span><span class="is-warning">Предупреждение</span><span class="is-critical">Критическое</span><span class="is-premium">Расширенный доступ</span><span class="is-neutral">Нейтральное</span></div>
          </UiKitSection>

          <UiKitSection id="colors" eyebrow="02 · Цвета" title="Тёплая база, глубокий индиго" description="Коралловый применяется редко; семантические цвета зарезервированы для статусов и никогда не работают без текста.">
            {paletteGroups.map((group) => <div class="ui-kit-palette-group"><h3>{group.name}</h3><div class="ui-kit-swatch-grid">{group.swatches.map(([token, value, role]) => <UiKitSwatch token={token} value={value} role={role} color={value} />)}</div></div>)}
          </UiKitSection>

          <UiKitSection id="typography" eyebrow="03 · Типографика" title="Одна семья, ясная иерархия" description="Onest в репозитории не подключён, поэтому витрина использует утверждённый запасной набор: Inter / системный интерфейс.">
            <div class="ui-kit-type-specimens">
              <div class="ui-kit-type-row"><code>display.l · 64/42</code><p class="ui-kit-type-display-l">Работа, которой можно доверять</p></div>
              <div class="ui-kit-type-row"><code>display.m · 52/38</code><p class="ui-kit-type-display-m">Проверенные сигналы</p></div>
              <div class="ui-kit-type-row"><code>heading.h1 · 44/32</code><p class="ui-kit-type-h1">Northstar Digital Lab</p></div>
              <div class="ui-kit-type-heading-grid"><div><code>H2 · 34/28</code><h2>Решение до отклика</h2></div><div><code>H3 · 24/22</code><h3>Найм и карьера</h3></div><div><code>H4 · 20/18</code><h4>Свежесть данных</h4></div></div>
              <div class="ui-kit-type-body-grid"><p class="ui-kit-body-l"><code>body.l</code> Длинное русское описание проверяет комфорт чтения и естественные переносы на узком экране.</p><p><code>body.m</code> Факты остаются читаемыми на русском и английском без декоративного шрифта.</p><p class="ui-kit-body-s"><code>body.s</code> Источник, методология и дополнительный контекст.</p><p class="ui-kit-caption"><code>caption</code> Проверено 31.07.2026</p><p class="ui-kit-label"><code>label</code> АКТИВНЫЙ НАЙМ</p></div>
              <div class="ui-kit-tabular"><span>Табличные цифры</span><strong>4,7</strong><strong>1 284</strong><strong>31.07.2026</strong></div>
            </div>
          </UiKitSection>

          <UiKitSection id="spacing-grid" eyebrow="04 · Отступы и сетка" title="Ритм 8 px, детализация 4 px" description="Внешний отступ меняется по контексту: 32 px на компьютере, 24 px на планшете, 16 px на телефоне.">
            <div class="ui-kit-spacing-scale">{spacing.map(([token, value]) => <div><code>{token}</code><span style={`--space-demo: ${value}px`}></span><b>{value}px</b></div>)}</div>
            <div class="ui-kit-grid-demo"><div><h3>Компьютер · 12 колонок</h3><div class="ui-kit-grid ui-kit-grid--12">{Array.from({ length: 12 }, (_, i) => <span>{i + 1}</span>)}</div><p>Межколонник 24–32 · внешний отступ 32 · максимум 1280</p></div><div><h3>Планшет · 8 колонок</h3><div class="ui-kit-grid ui-kit-grid--8">{Array.from({ length: 8 }, (_, i) => <span>{i + 1}</span>)}</div><p>Межколонник 20 · внешний отступ 24</p></div><div><h3>Телефон · 4 колонки</h3><div class="ui-kit-grid ui-kit-grid--4">{Array.from({ length: 4 }, (_, i) => <span>{i + 1}</span>)}</div><p>Межколонник 16 · внешний отступ 16</p></div></div>
          </UiKitSection>

          <UiKitSection id="shape" eyebrow="05 · Радиусы и уровни" title="Радиус описывает тип объекта" description="Статические поверхности полагаются на границы и пространство; тень появляется только у реального верхнего слоя.">
            <div class="ui-kit-radius-grid">{[["xs",4],["s",8],["m",12],["l",16],["xl",20],["2xl",24],["round",999]].map(([name, value]) => <div style={`--radius-demo: ${value}px`}><span></span><code>radius.{name}</code><b>{value}px</b></div>)}</div>
            <div class="ui-kit-border-grid"><div class="is-subtle">Тонкая · 1 px</div><div>Обычная · 1 px</div><div class="is-strong">Усиленная · 2 px</div><button type="button">Кольцо фокуса · 2 + 2</button></div>
            <div class="ui-kit-elevation-grid"><div>Статическая поверхность<small>shadow.none</small></div><div class="is-hover">Поверхность при наведении<small>shadow.hover</small></div><div class="is-dropdown">Выпадающий слой<small>shadow.dropdown</small></div><div class="is-sticky">Закреплённый слой<small>shadow.sticky</small></div><div class="is-overlay">Оверлей / боковая панель<small>shadow.overlay</small></div></div>
          </UiKitSection>

          <UiKitSection id="buttons" eyebrow="06 · Действия" title="Одно главное действие на блок" description="Все демонстрации используют реальные кнопки или ссылки, видимый фокус и стабильную ширину при загрузке.">
            <div class="ui-kit-demo-band"><h3>Варианты</h3><div class="ui-kit-button-row"><button class="ui-kit-button ui-kit-button--primary" type="button">Основная</button><button class="ui-kit-button ui-kit-button--secondary" type="button">Вторичная</button><button class="ui-kit-button ui-kit-button--tertiary" type="button">Текстовая</button><button class="ui-kit-button ui-kit-button--destructive" type="button">Опасное действие</button><button class="ui-kit-button ui-kit-button--premium" type="button">Расширенный доступ</button><button class="ui-kit-icon-button" type="button" aria-label="Поиск" title="Поиск"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg></button></div></div>
            <div class="ui-kit-demo-band"><h3>Состояния</h3><div class="ui-kit-button-row"><button class="ui-kit-button ui-kit-button--primary is-active" type="button" aria-pressed="true">Нажатое состояние <code>pressed</code></button><button class="ui-kit-button ui-kit-button--primary is-loading" type="button" aria-busy="true"><span>Загрузка</span></button><button class="ui-kit-button ui-kit-button--primary" type="button" disabled>Недоступно</button><button class="ui-kit-button ui-kit-button--success" type="button">Сохранено</button><button class="ui-kit-button ui-kit-button--secondary ui-kit-focus-demo" type="button">Видимый фокус <code>focus-visible</code></button></div></div>
            <div class="ui-kit-demo-band"><h3>Размеры</h3><div class="ui-kit-button-row ui-kit-button-row--end"><button class="ui-kit-button ui-kit-button--secondary ui-kit-button--compact" type="button">Компактная 36</button><button class="ui-kit-button ui-kit-button--secondary" type="button">Обычная 44</button><button class="ui-kit-button ui-kit-button--primary ui-kit-button--large" type="button">Выделенная 52</button></div></div>
          </UiKitSection>

          <UiKitSection id="forms" eyebrow="07 · Элементы форм" title="Подписи остаются видимыми" description="Заполнитель показывает пример, но не заменяет подпись. Ошибка, подсказка и состояние проверки располагаются рядом с полем.">
            <form class="ui-kit-form-showcase" novalidate>
              <label class="ui-kit-field"><span>Название компании</span><input type="text" placeholder="Например, Signal Works" /><small>Введите название или домен</small></label>
              <label class="ui-kit-field ui-kit-field--search"><span>Поиск по каталогу</span><div><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-4-4"></path></svg><input type="search" value="Продуктовая студия" /></div></label>
              <div class="ui-kit-field">
                <label for="ui-kit-company-type">Тип компании</label>
                <div class="ui-kit-select" data-state="closed">
                  <select id="ui-kit-company-type" class="ui-kit-select__control">
                    <option>Все типы</option><option selected>Продуктовая студия</option><option>Интегратор</option>
                  </select>
                  <span class="ui-kit-select__icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m4 6 4 4 4-4"></path></svg></span>
                </div>
                <small>Нативный список сохраняет системное меню и управление с клавиатуры</small>
              </div>
              <div class="ui-kit-field ui-kit-field--select-error">
                <label for="ui-kit-company-type-error">Тип компании · ошибка</label>
                <div class="ui-kit-select ui-kit-select--error" data-state="closed">
                  <select id="ui-kit-company-type-error" class="ui-kit-select__control" aria-invalid="true" aria-describedby="ui-kit-company-type-error-message">
                    <option selected value="">Выберите тип</option><option>Продуктовая студия</option><option>Интегратор</option>
                  </select>
                  <span class="ui-kit-select__icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m4 6 4 4 4-4"></path></svg></span>
                </div>
                <small id="ui-kit-company-type-error-message">Выберите один вариант</small>
              </div>
              <div class="ui-kit-field">
                <label for="ui-kit-company-type-disabled">Тип компании · недоступно</label>
                <div class="ui-kit-select" data-state="closed">
                  <select id="ui-kit-company-type-disabled" class="ui-kit-select__control" disabled>
                    <option selected>Источник недоступен</option>
                  </select>
                  <span class="ui-kit-select__icon" aria-hidden="true"><svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="m4 6 4 4 4-4"></path></svg></span>
                </div>
                <small>Выбор недоступен, пока источник не отвечает</small>
              </div>
              <label class="ui-kit-field ui-kit-field--error"><span>Рабочий email</span><input type="email" value="name@" aria-invalid="true" aria-describedby="email-error" /><small id="email-error">Укажите полный адрес, например name@company.ru</small></label>
              <label class="ui-kit-field"><span>Комментарий</span><textarea rows="4">Нужна компания с прозрачным форматом удалённой работы.</textarea></label>
              <label class="ui-kit-field"><span>Данные только для чтения</span><input type="text" value="Проверено 31.07.2026" readonly /></label>
              <label class="ui-kit-field"><span>Недоступный источник</span><input type="text" value="Источник недоступен" disabled /></label>
              <label class="ui-kit-field ui-kit-field--pending"><span>Проверка выполняется</span><input type="text" value="Проверяем источник" readonly aria-busy="true" /><small>Обычно занимает несколько секунд</small></label>
