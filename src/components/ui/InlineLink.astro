---
import ProductIcon from "./ProductIcon.astro";
import "../../styles/shared-tokens.css";

interface Props {
  href: string;
  external?: boolean;
  download?: boolean | string;
  class?: string;
  ariaLabel?: string;
}

const {
  href,
  external = false,
  download,
  class: className,
  ariaLabel,
} = Astro.props;

const accessibleLabel = ariaLabel
  ? `${ariaLabel}${external ? ", откроется в новой вкладке" : ""}`
  : undefined;
---

<a
  class:list={["inline-link", className]}
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  download={download}
  aria-label={accessibleLabel}
>
  <span class="inline-link__text"><slot /></span>{external && <><span class="inline-link__external-icon" aria-hidden="true"><ProductIcon name="external-link" size={12} /></span><span class="sr-only">, откроется в новой вкладке</span></>}
</a>

<style is:global>
  .inline-link,
  .inline-link:visited {
    color: var(--color-link);
    text-decoration: none;
  }

  .inline-link__text {
    padding-bottom: var(--link-underline-offset);
    background-image:
      repeating-linear-gradient(to right, var(--color-link-underline) 0 3px, transparent 3px 6px),
      linear-gradient(var(--color-link-underline), var(--color-link-underline));
    background-repeat: repeat-x, no-repeat;
    background-position: left calc(100% - 1px), left calc(100% - 1px);
    background-size: 6px 1px, 0 1px;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
    transition: background-size var(--motion-link) var(--ease-standard), color var(--motion-link) var(--ease-standard);
  }

  .inline-link__external-icon {
    display: inline-flex;
    align-items: baseline;
    margin-left: 4px;
    white-space: nowrap;
  }

  .inline-link__external-icon .product-icon { transform: translateY(1px); }

  .inline-link:hover,
  .inline-link:focus-visible { color: var(--color-link-hover); }

  .inline-link:hover .inline-link__text,
  .inline-link:focus-visible .inline-link__text,
  .inline-link:active .inline-link__text { background-size: 0 1px, 100% 1px; }

  .inline-link:active { color: var(--color-link-active); }

  .inline-link:focus-visible {
    border-radius: 2px;
    outline: 2px solid var(--color-focus-ring);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .inline-link__text { transition: none; }
  }
</style>
