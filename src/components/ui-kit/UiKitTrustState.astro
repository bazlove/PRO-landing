---
type Tone = "verified" | "fresh" | "warning" | "neutral" | "critical" | "insight" | "claim" | "ugc";

interface Props {
  tone: Tone;
  label: string;
  detail: string;
  source?: string;
  date?: string;
  confidence?: string;
  reason?: string;
}

const { tone, label, detail, source, date, confidence, reason } = Astro.props;

const paths: Record<Tone, string> = {
  verified: "M5 12.5 9.2 16.5 19 6.5",
  fresh: "M19 8a7 7 0 1 0 1 5M19 4v4h-4",
  warning: "M12 8v5m0 3h.01M10.3 3.9 2 18a2 2 0 0 0 1.7 3h16.6a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z",
  neutral: "M12 11v5m0-8h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
  critical: "M12 8v5m0 3h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z",
  insight: "M4 18V9m5 9V5m5 13v-6m5 6V3",
  claim: "M4 21h16M6 21V8l6-5 6 5v13M9 11h.01M12 11h.01M15 11h.01M9 15h.01M12 15h.01M15 15h.01",
  ugc: "M8 10h8M8 14h5M5 20l1.5-4A8 8 0 1 1 20 10a8 8 0 0 1-13.5 6Z",
};
---

<article class:list={["ui-kit-trust", `ui-kit-trust--${tone}`]}>
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d={paths[tone]}></path>
  </svg>
  <div>
    <strong>{label}</strong>
    <p>{detail}</p>
    <dl class="ui-kit-trust__meta">
      {source && <><dt>Источник</dt><dd>{source}</dd></>}
      {date && <><dt>Дата</dt><dd>{date}</dd></>}
      {confidence && <><dt>Уверенность</dt><dd>{confidence}</dd></>}
      {reason && <><dt>Причина</dt><dd>{reason}</dd></>}
    </dl>
  </div>
</article>
