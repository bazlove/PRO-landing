---
import ProductIcon from "../ui/ProductIcon.astro";
import type { ProductIconId } from "../../lib/icons/registry";

type Tone = "verified" | "fresh" | "warning" | "neutral" | "critical" | "insight" | "claim" | "external" | "ugc";

interface Props {
  tone: Tone;
  label: string;
  detail: string;
  source?: string;
  date?: string;
  confidence?: string;
  reason?: string;
}

const { tone, label, detail, source, date, confidence, reason } = Astro.props;

const toneIcons: Record<Tone, ProductIconId> = {
  verified: "verified",
  fresh: "refresh",
  warning: "stale",
  neutral: "information",
  critical: "conflict",
  insight: "platform-analysis",
  claim: "employer-claim",
  external: "source",
  ugc: "user-content",
};
---

<article class:list={["ui-kit-trust", `ui-kit-trust--${tone}`]}>
  <ProductIcon name={toneIcons[tone]} size={24} />
  <div>
    <strong>{label}</strong>
    <p>{detail}</p>
    <dl class="ui-kit-trust__meta">
      {source && <><dt>Источник</dt><dd>{source}</dd></>}
      {date && <><dt>Дата</dt><dd>{date}</dd></>}
      {confidence && <><dt>Уверенность</dt><dd>{confidence}</dd></>}
      {reason && <><dt>Причина</dt><dd>{reason}</dd></>}
    </dl>
  </div>
</article>
